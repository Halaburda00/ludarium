# --- Application ---
LUDARIUM_SECRET_KEY=replace-me-with-a-random-string
LUDARIUM_DATABASE_URL=sqlite+aiosqlite:///./data/ludarium.db
LUDARIUM_LOG_LEVEL=INFO

# --- The single account (ADR-0003) ---
# Required, with no fallback: the documented run command binds 0.0.0.0, so a
# default password would be a default password on the whole network.
# Reconciled on every start — changing the password here re-hashes it and signs
# every existing session out.
LUDARIUM_USERNAME=ludarium
LUDARIUM_PASSWORD=

# --- Encryption key for platform tokens (Fernet) ---
# Required. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored credential undecryptable.
LUDARIUM_ENCRYPTION_KEY=

# --- External APIs ---
# Not read by Settings. Platform credentials are entered in the UI and stored
# encrypted; these entries are here for local experiments only.
STEAM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
