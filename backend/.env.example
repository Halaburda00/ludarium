# --- Application ---
LUDARIUM_SECRET_KEY=replace-me-with-a-random-string
LUDARIUM_DATABASE_URL=sqlite+aiosqlite:///./data/ludarium.db
LUDARIUM_LOG_LEVEL=INFO
# Files the instance fetches, cover art today. Beside the default database;
# back it up with it, and keep it out of git and images (ADR-0019).
LUDARIUM_DATA_DIR=./data

# --- The single account (ADR-0003) ---
# Required, with no fallback: the documented run command binds 0.0.0.0, so a
# default password would be a default password on the whole network.
# Reconciled on every start — changing the password here re-hashes it and signs
# every existing session out.
LUDARIUM_USERNAME=ludarium
LUDARIUM_PASSWORD=

# --- Encryption key for platform tokens (Fernet) ---
# Required. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored credential undecryptable.
LUDARIUM_ENCRYPTION_KEY=

# --- IGDB, through a Twitch application (optional) ---
# Without these the instance still syncs libraries and enriches nothing. Both or
# neither: half an application is refused at start. Register an application in
# the Twitch developer console to get them. IGDB is free for non-commercial use
# under the Twitch Developer Service Agreement.
LUDARIUM_IGDB_CLIENT_ID=
LUDARIUM_IGDB_CLIENT_SECRET=

# --- RAWG, for Metacritic scores (optional) ---
# Without it no scores are fetched. Needs IGDB too: only works IGDB has matched
# are looked up. Register at rawg.io/apidocs; the free tier is 20 000 requests a
# month, and RAWG's terms require the credit and link the UI shows beside every
# score.
LUDARIUM_RAWG_API_KEY=

# --- Scheduled sync (optional) ---
# Every connected platform is synced this often, in hours, counted from its
# last success; 0 turns it off. Per platform: LUDARIUM_SYNC_INTERVALS as a JSON
# object, for example {"epic": 24}. Runs in the application process, so run
# one process only (ADR-0036).
LUDARIUM_SYNC_INTERVAL_HOURS=6
LUDARIUM_SYNC_INTERVALS={}

# --- Demo mode (optional) ---
# Shows a made-up library to anyone who opens the instance, signed in without a
# password and read-only (ADR-0034). Seeded on the first start into an empty
# database; a database holding a library of its own is refused. Username and
# password are still required, and nobody uses them.
LUDARIUM_DEMO=false

# --- External APIs ---
# Not read by Settings. Platform credentials are entered in the UI and stored
# encrypted; these entries are here for local experiments only.
STEAM_API_KEY=
