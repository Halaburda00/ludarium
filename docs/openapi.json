  "info": {
    "title": "Ludarium",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "connected_api_accounts_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "ludarium_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ludarium Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountResponse"
                  },
                  "title": "Response Connected Api Accounts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
