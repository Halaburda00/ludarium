      "Score": {
        "description": "A Metacritic score and the page of the source it came from, which is RAWG.\n\nOne object so the two cannot be separated: RAWG's terms require an active\nlink wherever its data is shown, and a score the API hands out without its\nlink is a score some client will show without it.",
        "properties": {
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
