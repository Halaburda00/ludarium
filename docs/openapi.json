      "LoginRequest": {
        "description": "Bounded, because this is the one endpoint that answers before authenticating.\n\nNot because argon2's cost scales with the input \u2014 measured, a 10 MB password\ncosts 62 ms against 49 ms for a short one, since the memory-hard phase is\nfixed. The reason is upstream of that: an unbounded string is buffered whole\nand carried through validation before anything gets to decide it is wrong.",
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 1024,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 256,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
