{
  "components": {
    "schemas": {
      "AccountResponse": {
        "description": "What the frontend may know about a connected account.\n\n`credentials` is the mask and nothing else. There is no field here that\ncould carry the ciphertext either: an encrypted secret in a response is\nstill the secret, one key away.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "credentials": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credentials"
          },
          "external_account_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Account Id"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_success_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SyncStatus"
          }
        },
        "required": [
          "id",
          "provider",
          "external_account_id",
          "label",
          "is_active",
          "created_at",
          "last_success_at",
          "status",
          "last_error",
          "credentials"
        ],
        "title": "AccountResponse",
        "type": "object"
      },
